{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.quaerens.co.uk/complaint-builder/schemas/resource.schema.json",
  "title": "Quaerens Official Resource",
  "type": "object",
  "required": ["label", "url", "sourceType"],
  "properties": {
    "label": { "type": "string" },
    "url": { "type": "string" },
    "sourceType": { "enum": ["official", "regulator", "ombudsman", "legislation", "guidance"] },
    "lastChecked": { "type": "string" }
  }
}
