{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.quaerens.co.uk/complaint-builder/schemas/directory.schema.json",
  "title": "Quaerens Submission Directory",
  "type": "object",
  "required": ["type", "entries"],
  "properties": {
    "type": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tradingName", "lastVerified"],
        "properties": {
          "tradingName": { "type": "string" },
          "legalEntity": { "type": "string" },
          "iata": { "type": "string" },
          "icao": { "type": "string" },
          "officialComplaintForm": { "type": "string" },
          "email": { "type": "string" },
          "postalAddress": { "type": "string" },
          "website": { "type": "string" },
          "adr": { "type": "string" },
          "lastVerified": { "type": "string" }
        }
      }
    }
  }
}
