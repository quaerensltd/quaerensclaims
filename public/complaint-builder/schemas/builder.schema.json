{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.quaerens.co.uk/complaint-builder/schemas/builder.schema.json",
  "title": "Quaerens Complaint Builder Configuration",
  "type": "object",
  "required": ["id", "productName", "packPrefix", "stages"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "productName": { "type": "string" },
    "shortName": { "type": "string" },
    "pageTitle": { "type": "string" },
    "h1": { "type": "string" },
    "canonicalUrl": { "type": "string" },
    "storageNamespace": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "packPrefix": { "type": "string", "pattern": "^[A-Z0-9]{1,4}$" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    }
  }
}
