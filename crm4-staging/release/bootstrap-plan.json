    {
      "id": "private-run-service",
      "stage": "deployment",
      "approved": false,
      "method": "POST",
      "url": "https://run.googleapis.com/v2/projects/quaerens-crm4-spain-test/locations/europe-west1/services?serviceId=crm4-spain-test",
      "body": {
        "ingress": "INGRESS_TRAFFIC_ALL",
        "iapEnabled": true,
        "invokerIamDisabled": false,
        "template": {
          "serviceAccount": "crm4-runtime@quaerens-crm4-spain-test.iam.gserviceaccount.com",
          "scaling": {
            "minInstanceCount": 0,
            "maxInstanceCount": 2
          },
          "maxInstanceRequestConcurrency": 8,
          "timeout": "120s",
          "containers": [
            {
              "image": "europe-west1-docker.pkg.dev/quaerens-crm4-spain-test/crm4-release/crm4-spain@sha256:<approved-image-digest>",
              "ports": [
                {
                  "containerPort": 8080
                }
              ],
              "resources": {
                "limits": {
                  "cpu": "1",
                  "memory": "1Gi"
                },
                "cpuIdle": true
              },
              "env": [
                {
                  "name": "GCLOUD_PROJECT",
                  "value": "quaerens-crm4-spain-test"
                },
                {
                  "name": "CRM4_CONFIG_FILE",
                  "value": "/app/release/runtime-config.json"
                },
                {
                  "name": "CRM4_DEPLOYMENT_APPROVED",
                  "value": "true"
                },
                {
                  "name": "ASSESSMENT_REPORT_ARCHIVE_EMAIL",
                  "value": "archive@example.test"
                }
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "container-build",
        "oauth"
      ],
      "before": "Separate exact-image deployment approval required; replace digest placeholder, verify runtime approval config and origin. Never create a placeholder service under infrastructure-only approval."
