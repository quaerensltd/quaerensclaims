  "rules": {
    "status": 200,
    "body": {
      "name": "projects/quaerens-crm4-spain-test/rulesets/a91a62a8-6624-4485-a0c3-b8ac26a537f6",
      "source": {
        "files": [
          {
            "content": "rules_version = '2';\nservice firebase.storage {\n  match /b/{bucket}/o {\n    match /clientPortal/{caseId}/shared/{filename} {\n      allow create: if bucket == 'quaerens-crm4-spain-test.firebasestorage.app'\n        && resource == null && request.auth != null\n        && firestore.get(/databases/(default)/documents/crm4Memberships/$(request.auth.uid)).data.active == true\n        && firestore.get(/databases/(default)/documents/crm4Memberships/$(request.auth.uid)).data.workspaceId == 'CRM4'\n        && firestore.get(/databases/(default)/documents/crm4Memberships/$(request.auth.uid)).data.role in ['manager','administrator','processing']\n        && firestore.get(/databases/(default)/documents/clientPortalCases/$(caseId)).data.portalVersion == 2\n        && firestore.get(/databases/(default)/documents/clientPortalCases/$(caseId)).data.crmLink.workspaceId == 'CRM4'\n        && firestore.get(/databases/(default)/documents/clientPortalCases/$(caseId)).data.crmLink.collection == 'crm4Leads'\n        && firestore.get(/databases/(default)/documents/crm4Leads/$(firestore.get(/databases/(default)/documents/clientPortalCases/$(caseId)).data.crmLink.caseId)).data.workspaceId == 'CRM4'\n        && request.resource.size > 0 && request.resource.size <= 15 * 1024 * 1024\n        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp', 'text/plain', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];\n    }\n    match /clientPortal/{caseId}/client-uploads/{uid}/{filename} {\n      allow create: if bucket == 'quaerens-crm4-spain-test.firebasestorage.app'\n        && resource == null\n        && request.auth != null && request.auth.uid == uid\n        && request.auth.token.email_verified == true\n        && (firestore.get(/databases/(default)/documents/clientPortalCases/$(caseId)).data.get('workspaceId','') == 'CRM4' || firestore.get(/databases/(default)/documents/clientPortalCases/$(caseId)).data.get('crmLink',{}).get('workspaceId','') == 'CRM4')\n        && firestore.get(/databases/(default)/documents/clientPortalCases/$(caseId)).data.get('workspaceId','CRM4') == 'CRM4'\n        && firestore.get(/databases/(default)/documents/clientPortalCases/$(caseId)).data.get('crmLink',{}).get('workspaceId','CRM4') == 'CRM4'\n        && firestore.get(/databases/(default)/documents/clientPortalCases/$(caseId)).data.clientUid == uid\n        && firestore.get(/databases/(default)/documents/clientPortalCases/$(caseId)).data.accessState == 'ACTIVE'\n        && request.resource.size > 0 && request.resource.size <= 15 * 1024 * 1024\n        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp', 'text/plain', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];\n    }\n    match /{object=**} { allow read, write: if false; }\n  }\n}\n",
            "name": "storage.rules"
          }
        ]
      },
      "createTime": "2026-10-13T20:46:25.838687Z",
      "metadata": {
        "services": [
          "firebase.storage"
        ]
      }
    }
