        "DOCKER_BUILDKIT=1"
      ],
      "args": [
        "build",
        "--progress=plain",
        "--platform=linux/amd64",
        "--build-arg",
        "COMPILER_IMAGE=node:22.23.3-trixie@sha256:e2b06d8e287f66a905c2da31bbd64482fa3aba9aee05a1ccf5ecdb636bbfeb86",
        "--build-arg",
        "RUNTIME_IMAGE=gcr.io/distroless/nodejs22-debian13:nonroot@sha256:7b0a2b9262b3d1d57e139e08fe11bccb0a7d426ca515eab0cd6abcaf2016ae5c",
        "--file",
        "release/zlib-remediation/Dockerfile.validation",
        "--tag",
        "crm4-zlib-validation:local",
