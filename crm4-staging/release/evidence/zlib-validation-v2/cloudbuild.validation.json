      "entrypoint": "bash",
      "args": [
        "-ceu",
        "test -d /workspace/validation-output/evidence; tar -czf /workspace/native-diagnostics.tar.gz -C /workspace/validation-output evidence; sha256sum /workspace/native-diagnostics.tar.gz; echo CRM4_DIAGNOSTICS_BASE64_BEGIN; base64 -w 3000 /workspace/native-diagnostics.tar.gz; echo; echo CRM4_DIAGNOSTICS_BASE64_END"
      ]
