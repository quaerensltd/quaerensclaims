      "entrypoint": "bash",
      "args": [
        "-ceu",
        "mkdir -p /workspace/validation-output; docker run --rm --workdir=/work --memory=7g --memory-swap=7g --cpus=4 --mount type=bind,src=/workspace/release/zlib-remediation,dst=/recipe,readonly --mount type=bind,src=/workspace/validation-output,dst=/out node:22.23.3-trixie@sha256:e2b06d8e287f66a905c2da31bbd64482fa3aba9aee05a1ccf5ecdb636bbfeb86 timeout --signal=TERM --kill-after=30s 6600s bash /recipe/compile.sh"
