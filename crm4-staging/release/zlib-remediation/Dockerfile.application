ARG COMPILER_IMAGE
ARG RUNTIME_IMAGE
FROM ${COMPILER_IMAGE} AS dependencies
WORKDIR /app
COPY validation-output /out
RUN test "$(cat /out/evidence/native-success)" = PASS
COPY release ./release
RUN cd release && npm ci --omit=dev --ignore-scripts --no-audit --no-fund && rm -rf zlib-remediation
FROM ${RUNTIME_IMAGE} AS application
WORKDIR /app
ENV NODE_ENV=production CRM4_CONFIG_FILE=/app/release/runtime-config.json NODE_PATH=/app/release/node_modules
COPY backend-sources ./backend-sources
COPY tools ./tools
COPY --from=dependencies /app/release ./release
COPY cloud-public ./cloud-public
COPY --from=dependencies /out/node/node /nodejs/bin/node
COPY --from=dependencies /out/package/usr/lib/x86_64-linux-gnu/ /usr/lib/x86_64-linux-gnu/
COPY --from=dependencies /out/status/ /var/lib/dpkg/status.d/
USER 65532:65532
FROM application AS verified
COPY --from=dependencies /out/evidence/ /validation/
RUN ["/nodejs/bin/node", "-e", "const a=require('node:assert/strict'),fs=require('node:fs'),crypto=require('node:crypto'),h=require('/validation/runtime-hashes.json'),sha=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');a.equal(sha('/nodejs/bin/node'),h.node);a.equal(sha('/usr/lib/x86_64-linux-gnu/libz.so.1.3.1'),h.systemZlib);a.equal(require('/validation/gzwrite.node').verify(),process.execPath);const c=require('node:child_process').spawnSync('/validation/system-regression',[],{env:{...process.env,LD_LIBRARY_PATH:'/usr/lib/x86_64-linux-gnu',CRM4_EXPECT_LIBRARY:'/usr/lib/x86_64-linux-gnu'},stdio:'inherit'});a.equal(c.status,0);console.log('Both patched components used in distroless runtime: PASS');"]
RUN ["/nodejs/bin/node", "release/runtime-smoke.cjs"]
FROM application AS runtime
# This dependency forces verification while excluding test binaries and logs.
COPY --from=verified /validation/runtime-hashes.json /app/release/native-runtime-hashes.json
EXPOSE 8080
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["release/server.cjs"]
