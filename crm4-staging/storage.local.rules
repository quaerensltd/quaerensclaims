rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /clientPortal/{caseId}/client-uploads/{uid}/{filename} {
      allow create: if bucket == 'demo-quaerens-crm4.appspot.com'
        && resource == null
        && request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/clientPortalCases/$(caseId)).data.clientUid == uid
        && firestore.get(/databases/(default)/documents/clientPortalCases/$(caseId)).data.accessState == 'ACTIVE'
        && request.resource.size > 0 && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp', 'text/plain', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
    }
    match /{object=**} { allow read, write: if false; }
  }
}
