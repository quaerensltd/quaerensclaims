<html>
<head>
  <meta charset="utf-8">
  <title>Quaerens Ltd - Revised 12-Month P&L and Operating Forecast</title>
  <style>
    body { font-family: Arial, Helvetica, sans-serif; color: #0f172a; line-height: 1.45; margin: 34px; }
    h1 { color: #0052a4; font-size: 24px; margin: 28px 0 10px; }
    h2 { color: #0f172a; font-size: 18px; margin: 18px 0 8px; }
    p { margin: 8px 0; font-size: 14px; }
    .title { text-align: center; margin-bottom: 24px; }
    .title h1 { font-size: 30px; margin: 0; color: #0052a4; }
    .title h2 { font-size: 21px; margin: 6px 0; }
    .note { font-style: italic; color: #475569; }
    table { width: 100%; border-collapse: collapse; margin: 12px 0 18px; font-size: 13px; }
    th { background: #0052a4; color: #fff; text-align: left; padding: 8px; border: 1px solid #cbd5e1; }
    td { padding: 8px; border: 1px solid #cbd5e1; vertical-align: top; }
    ul { margin: 8px 0 14px 22px; }
    li { margin: 4px 0; font-size: 14px; }
