rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function crm2Membership() {
      return get(/databases/$(database)/documents/crm2Memberships/$(request.auth.uid));
    }

    function isCrm2Member() {
      return request.auth != null
        && exists(/databases/$(database)/documents/crm2Memberships/$(request.auth.uid))
        && crm2Membership().data.active == true
        && crm2Membership().data.workspaceId == "CRM2";
    }

    function crm2RoleIs(role) {
      return isCrm2Member() && crm2Membership().data.role == role;
    }

    function crm2WorkspaceUnchanged() {
      return request.resource.data.workspaceId == "CRM2"
        && resource.data.workspaceId == "CRM2"
        && request.resource.data.source in ["manual_crm2", "lead_upload_crm2"]
        && request.resource.data.source == resource.data.source
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Memberships are issued only by trusted Admin SDK code. Client writes are never allowed.
    match /crm2Memberships/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.platformAdmin == true || crm2RoleIs("manager") || crm2RoleIs("administrator"));
      allow write: if false;
    }

    match /crm2Leads/{leadId} {
      allow read: if isCrm2Member()
        && (!crm2RoleIs("closer")
          || resource.data.status in ["approved", "closer-assigned", "appointment-booked", "onboarded"]);
      allow create: if isCrm2Member()
        && (crm2RoleIs("lister") || crm2RoleIs("manager") || crm2RoleIs("administrator"))
        && request.resource.data.workspaceId == "CRM2"
        && request.resource.data.source in ["manual_crm2", "lead_upload_crm2"]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "new";
      allow update: if crm2WorkspaceUnchanged()
        && (
          crm2RoleIs("administrator")
          || (crm2RoleIs("manager")
            && request.resource.data.status in ["awaiting-manager-review", "information-requested", "approved", "rejected"])
          || (crm2RoleIs("lister")
            && resource.data.status in ["new", "information-requested", "awaiting-manager-review"]
            && request.resource.data.status in ["new", "information-requested", "awaiting-manager-review", "rejected"])
          || (crm2RoleIs("closer")
            && resource.data.status in ["approved", "closer-assigned", "appointment-booked", "onboarded"]
            && request.resource.data.status in ["approved", "closer-assigned", "appointment-booked", "onboarded"])
        );
      allow delete: if crm2RoleIs("administrator");
    }

    match /crm2Assessments/{assessmentId} {
      allow read: if isCrm2Member()
        && (!crm2RoleIs("closer")
          || get(/databases/$(database)/documents/crm2Leads/$(resource.data.caseId)).data.status
            in ["approved", "closer-assigned", "appointment-booked", "onboarded"]);
      allow create: if isCrm2Member()
        && request.resource.data.workspaceId == "CRM2"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.assessmentRoute in ["solar", "spray-foam"]
        && exists(/databases/$(database)/documents/crm2Leads/$(request.resource.data.caseId));
      allow update: if isCrm2Member()
        && request.resource.data.workspaceId == "CRM2"
        && resource.data.workspaceId == "CRM2"
        && request.resource.data.caseId == resource.data.caseId
        && request.resource.data.assessmentRoute == resource.data.assessmentRoute
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if crm2RoleIs("administrator");
    }

    match /crm2Activities/{activityId} {
      allow read: if isCrm2Member() && resource.data.workspaceId == "CRM2";
      allow create: if isCrm2Member()
        && request.resource.data.workspaceId == "CRM2"
        && request.resource.data.activityType in ["clientTimeline", "agendaItems", "sentEmails", "agreementRecords"];
      allow update: if isCrm2Member()
        && resource.data.workspaceId == "CRM2"
        && request.resource.data.workspaceId == "CRM2"
        && request.resource.data.activityType == resource.data.activityType
        && (crm2RoleIs("manager") || crm2RoleIs("administrator") || resource.data.ownerUid == request.auth.uid || resource.data.createdByUid == request.auth.uid || resource.data.assignedUserId == request.auth.uid);
      allow delete: if crm2RoleIs("manager") || crm2RoleIs("administrator");
    }

    match /crm2Attendance/{attendanceId} {
      allow read: if isCrm2Member();
      allow create, update: if isCrm2Member()
        && request.resource.data.workspaceId == "CRM2"
        && request.resource.data.uid == request.auth.uid;
      allow delete: if crm2RoleIs("administrator");
    }

    // Framework C records are accessible only through protected Cloud Functions.
    // Version 1 never creates an operational CRM record.
    match /intakeGatewayPreparedCases/{caseId} {
      allow read, write: if false;

      match /audit/{auditId} {
        allow read, write: if false;
      }
    }

    // Framework A metrics are aggregate-only and accessible exclusively through protected backend functions.
    match /frameworkAMetricsDaily/{date} {
      allow read, write: if false;
    }

    // Client portal cases created by Quaerens admin and opened by clients using email + access code.
    match /clientPortalCases/{caseId} {
      allow read: if true;
      allow create: if request.resource.data.clientName is string
        && request.resource.data.clientEmail is string
        && request.resource.data.clientEmailLower is string
        && request.resource.data.portalCode is string;
      allow update: if true;
      allow delete: if false;
    }

    // Client/admin message thread for a portal case.
    match /clientPortalMessages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.caseId is string
        && request.resource.data.body is string;
      allow update, delete: if false;
    }

    // Document metadata for client uploads.
    match /clientPortalDocuments/{documentId} {
      allow read: if true;
      allow create: if request.resource.data.caseId is string
        && request.resource.data.name is string;
      allow update, delete: if false;
    }

    // Existing public CRM pages use client-side Firebase reads/writes.
    // Keep current behaviour working while we test the portal.
    match /{collection}/{document=**} {
      allow read, write: if ((request.auth != null && request.auth.token.platformAdmin == true)
          || !isCrm2Member())
        && collection != "crm2Memberships"
        && collection != "crm2Leads"
        && collection != "crm2Assessments"
        && collection != "crm2Activities"
        && collection != "crm2Attendance"
        && collection != "intakeGatewayPreparedCases";
    }
  }
}
