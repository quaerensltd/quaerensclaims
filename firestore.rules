rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Client portal cases created by Quaerens admin and opened by clients using email + access code.
    match /clientPortalCases/{caseId} {
      allow read: if true;
      allow create: if request.resource.data.clientName is string
        && request.resource.data.clientEmail is string
        && request.resource.data.clientEmailLower is string
        && request.resource.data.portalCode is string;
      allow update: if true;
      allow delete: if false;
    }

    // Client/admin message thread for a portal case.
    match /clientPortalMessages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.caseId is string
        && request.resource.data.body is string;
      allow update, delete: if false;
    }

    // Document metadata for client uploads.
    match /clientPortalDocuments/{documentId} {
      allow read: if true;
      allow create: if request.resource.data.caseId is string
        && request.resource.data.name is string;
      allow update, delete: if false;
    }

    // Existing public CRM pages use client-side Firebase reads/writes.
    // Keep current behaviour working while we test the portal.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
